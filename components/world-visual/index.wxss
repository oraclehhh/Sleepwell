@keyframes dandelionHoldSwayStrong {
  0% { transform: translate(-50%, -50%) scale(1.05) rotate(-7deg); }
  25% { transform: translate(-50%, -50%) scale(1.06) rotate(4deg); }
  50% { transform: translate(-50%, -50%) scale(1.07) rotate(7deg); }
  75% { transform: translate(-50%, -50%) scale(1.06) rotate(-4deg); }
  100% { transform: translate(-50%, -50%) scale(1.05) rotate(-7deg); }
}
@keyframes dandelionInhaleRotate {
  0% { transform: translate(-50%, -50%) scale(1.02) rotate(-18deg); }
  32% { transform: translate(-50%, -50%) scale(1.06) rotate(-4deg); }
  65% { transform: translate(-50%, -50%) scale(1.08) rotate(18deg); }
  100% { transform: translate(-50%, -50%) scale(1.04) rotate(-12deg); }
}
.photo-seeds--completed .photo-seed {
  opacity: 0;
  transform: translate3d(180rpx, -120rpx, 0) rotate(32deg) scale(.24);
}

