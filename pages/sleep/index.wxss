.sleep-page { min-height: 100vh; }.topbar-label { color: var(--text-soft); font-size: 24rpx; letter-spacing: 2rpx; }.topbar-spacer { width: 80rpx; }.sleep-content { padding: 56rpx 48rpx; }.time-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 54rpx; }.time-field { min-height: 152rpx; padding: 26rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: rgba(255,255,255,.025); }.time-field text { display: block; color: var(--text-faint); font-size: 22rpx; }.time-field .time-value { margin-top: 22rpx; color: var(--text-main); font-size: 40rpx; }.duration-band { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 28rpx 26rpx; border-bottom: 1rpx solid var(--line); color: var(--text-soft); }.duration-band .duration-value { color: var(--accent); font-weight: 500; }.feeling-section { margin: 58rpx 0 52rpx; }.feeling-scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }.feeling-button { display: flex; align-items: center; justify-content: center; aspect-ratio: 1; border: 1rpx solid var(--line); border-radius: 50%; color: var(--text-faint); }.feeling-button.is-selected { color: #0a1b19; border-color: var(--accent); background: var(--accent); box-shadow: 0 0 30rpx rgba(204,227,194,.16); }.feeling-labels { display: flex; justify-content: space-between; margin-top: 14rpx; color: var(--text-faint); font-size: 20rpx; }.sleep-history { margin-top: 72rpx; }.history-title { color: var(--text-faint); font-size: 23rpx; }.sleep-row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }.sleep-row view:last-child { text-align: right; }.sleep-row text { display: block; }.sleep-row view text:last-child { margin-top: 8rpx; color: var(--text-faint); font-size: 21rpx; }.sleep-row .sleep-duration { color: var(--text-soft); font-size: 28rpx; }
